# environment
.venv/
__pycache__/
*.pyc
*.egg-info/

# paper copies (copyright of the authors; see README for the arXiv link)
2606.03780.pdf
2309.16042.pdf
paper.txt
paper_src/

# agent transcripts and machine-local files
logs/agent_*.jsonl
logs/agent_*.err
logs/agent_session_id.txt
scripts/claude_bin.txt
.ddtest
*.incomplete

# model weights are never stored here (HF_HOME=/opt/dlami/nvme/hf)
hf/
offload/
logs/gpu.lock

# third-party WinoGrande 1.1 copy (official zip: storage.googleapis.com/ai2-mosaic/public/winogrande/winogrande_1.1.zip)
data/winogrande_1.1/

# large CodeFact intermediates (regenerable from scan_rows + items.jsonl)
results/codefact_*/scan_routing.parquet
results/codefact_*/expert_parts/
results/codefact_smoke/
# Phase 7 (RelP on SVA): .venv is a symlink to .venv-relp; large or regenerable result files stay on the root disk only
/.venv
results/relp_sva_moe/**/aggregate*.pt
results/relp_sva_moe/**/per_row_expert_scores.pt
results/relp_sva_moe/**/routes.pt
results/relp_sva_moe/**/interventions.jsonl
results/relp_moe_dev/**/*.pt

# Phase 8 (RelP follow-ups): kept on the root disk only -
#  resumable chunk files that are merged row for row into the parquet beside them (patch / freeze / noise / neuron_patch),
#  raw router-logit dumps (input of the GPU `rules` step only) and stage-3 routing records (input of the GPU steps only)
results/relp_sva_moe/**/p8_*/*_part_[0-9]*.npz
results/relp_sva_moe/**/p8_probe/router_logits.npy
results/relp_p8/**/*_part_[0-9]*.npz
results/relp_p8/**/routes_T*.pt
results/relp_moe_dev/p8_smoke*/**/*_part_[0-9]*.npz
results/relp_moe_dev/p8_smoke*/**/router_logits.npy
